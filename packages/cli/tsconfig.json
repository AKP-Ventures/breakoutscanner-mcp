{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noEmit": false,
    "incremental": false,
    "lib": ["ES2022", "DOM"],
    "paths": {
      "@breakoutscanner/mcp-sdk": ["../sdk/dist/index.d.ts"]
    }
  },
  "include": ["src/**/*.ts"]
}
